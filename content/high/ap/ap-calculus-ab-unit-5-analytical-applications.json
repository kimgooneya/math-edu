{
  "schemaVersion":1,"id":"ap-calculus-ab-unit-5-analytical-applications","title":"Unit 5: Analytical Applications of Differentiation","stage":"high","grade":"Grades 11–12","course":"AP Calculus AB","domain":"Analytical Applications of Differentiation","framework":"College Board AP","level":"AP","standards":["AP Calculus AB Unit 5"],"aliases":["미분의 해석적 응용","AP Calculus AB U5"],"sources":["https://apcentral.collegeboard.org/courses/ap-calculus-ab"],
