{
  "schemaVersion":1,"id":"ap-statistics-unit-3-inference-proportions","title":"Unit 3: Inference for Categorical Data: Proportions","stage":"high","grade":"Grades 10–12","course":"AP Statistics","domain":"Inference for Proportions","framework":"College Board AP","level":"AP","standards":["AP Statistics Unit 3 (Effective Fall 2026)"],"aliases":["범주형 자료 추론: 비율","AP Statistics U3","2026–27 revised framework"],"sources":["https://apcentral.collegeboard.org/courses/ap-statistics","https://apcentral.collegeboard.org/courses/ap-statistics/future-revisions"],
  "description":"표본비율의 분포, 한·두 비율 신뢰구간과 검정, p값·오류·검정력, 카이제곱 동질성·독립성 검정을 다룹니다.","estimatedMinutes":65,"prerequisites":["ap-statistics-unit-2-probability-distributions"],"pathways":["ap-statistics-unit-4-inference-means"],
  "objectives":["한·두 모집단 비율에 대한 z 신뢰구간과 가설검정의 조건·계산·결론을 수행할 수 있다.","카이제곱 동질성·독립성 검정을 설정하고 p값과 오류를 맥락에서 해석할 수 있다."],
  "theory":[
    {"type":"concept","title":"표본비율의 표집분포","body":"무작위성과 10% 조건, 큰 계수 조건을 만족하면 표본비율은 평균 p, 표준편차 √[p(1-p)/n]인 근사 정규분포를 따릅니다."},
    {"type":"concept","title":"신뢰구간","body":"추정값±임계값×표준오차로 그럴듯한 모집단 모수 범위를 만듭니다. 신뢰수준은 장기적으로 모수를 포착하는 구간 절차의 비율입니다."},
    {"type":"concept","title":"가설검정과 오류","body":"p값은 귀무가설이 참일 때 관측 결과만큼 또는 더 극단적인 결과가 나올 확률입니다. 제1종 오류는 참인 귀무가설을 기각하는 오류입니다."},
    {"type":"concept","title":"카이제곱 검정","body":"동질성 검정은 여러 모집단의 범주 분포를 비교하고 독립성 검정은 한 모집단의 두 범주형 변수 연관성을 조사합니다. 기대도수와 관측도수 차이를 사용합니다."}
  ],
  "problems":[
    {"id":"ap-statistics-unit-3-inference-proportions-p01","type":"number","prompt":"200명 중 120명이 찬성했다. 표본비율은?","answer":0.6,"hints":["성공 수를 표본 크기로 나누세요.","120/200을 계산하세요."],"explanation":"표본비율은 0.6입니다."},
    {"id":"ap-statistics-unit-3-inference-proportions-p02","type":"choice","prompt":"95% 신뢰구간 (0.52,0.68)의 올바른 결론은?","choices":[{"id":"a","label":"사용한 절차와 조건 아래 모집단 비율이 이 범위에 있다고 95% 신뢰한다"},{"id":"b","label":"표본비율이 95% 확률로 변한다"},{"id":"c","label":"모집단의 95%가 반드시 찬성한다"},{"id":"d","label":"귀무가설이 95% 확률로 참이다"}],"answer":"a","hints":["신뢰수준은 절차의 장기 성능입니다.","모집단 비율에 대한 추정임을 밝히세요."],"explanation":"신뢰구간은 모집단 비율에 대한 그럴듯한 값의 범위입니다."},
    {"id":"ap-statistics-unit-3-inference-proportions-p03","type":"choice","prompt":"유의수준 0.05에서 p값이 0.03이면?","choices":[{"id":"a","label":"귀무가설을 기각한다"},{"id":"b","label":"귀무가설을 증명한다"},{"id":"c","label":"대립가설을 기각한다"},{"id":"d","label":"표본을 버린다"}],"answer":"a","hints":["p값과 유의수준을 비교하세요.","0.03<0.05입니다."],"explanation":"p값이 유의수준보다 작으므로 귀무가설을 기각합니다."},
    {"id":"ap-statistics-unit-3-inference-proportions-p04","type":"choice","prompt":"제1종 오류는?","choices":[{"id":"a","label":"참인 귀무가설을 기각"},{"id":"b","label":"거짓인 귀무가설을 기각하지 않음"},{"id":"c","label":"표본평균 계산 실수"},{"id":"d","label":"항상 표본을 무작위로 뽑음"}],"answer":"a","hints":["제1종은 거짓 양성에 해당합니다.","귀무가설이 실제로 참인 상황입니다."],"explanation":"제1종 오류는 참인 H0를 잘못 기각하는 것입니다."},
    {"id":"ap-statistics-unit-3-inference-proportions-p05","type":"number","prompt":"카이제곱 한 셀에서 관측도수 15, 기대도수 12의 기여도 (O-E)²/E는?","answer":0.75,"hints":["차는 3입니다.","9/12를 계산하세요."],"explanation":"(15-12)²/12=9/12=0.75입니다."},
    {"id":"ap-statistics-unit-3-inference-proportions-p06","type":"choice","prompt":"한 모집단에서 성별과 교통수단 선택의 연관성을 검정할 때 적절한 것은?","choices":[{"id":"a","label":"카이제곱 독립성 검정"},{"id":"b","label":"한 평균 t 검정"},{"id":"c","label":"회귀 기울기 검정"},{"id":"d","label":"대응표본 t 검정"}],"answer":"a","hints":["두 변수 모두 범주형입니다.","한 모집단에서 변수의 연관성을 묻습니다."],"explanation":"한 모집단의 두 범주형 변수 연관성에는 카이제곱 독립성 검정을 씁니다."}
  ]
}
