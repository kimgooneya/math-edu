{
  "schemaVersion":1,"id":"ap-statistics-unit-2-probability-distributions","title":"Unit 2: Probability, Random Variables, and Probability Distributions","stage":"high","grade":"Grades 10–12","course":"AP Statistics","domain":"Probability and Random Variables","framework":"College Board AP","level":"AP","standards":["AP Statistics Unit 2 (Effective Fall 2026)"],"aliases":["확률·확률변수·확률분포","AP Statistics U2","2026–27 revised framework"],"sources":["https://apcentral.collegeboard.org/courses/ap-statistics","https://apcentral.collegeboard.org/courses/ap-statistics/future-revisions"],
