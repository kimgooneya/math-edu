  "theory": [
    {
      "type": "concept",
      "title": "거리로 정의한 타원과 쌍곡선",
      "body": "타원은 두 초점까지 거리의 합이 일정한 점들의 집합이고, 쌍곡선은 두 초점까지 거리 차의 절댓값이 일정한 점들의 집합입니다."
    },
    {
      "type": "concept",
      "title": "표준형과 이동",
      "body": "중심 또는 꼭짓점이 원점이 아닌 경우 x를 x-h, y를 y-k로 바꿉니다. 분모와 부호를 읽어 장축 방향, 꼭짓점, 점근선을 판단합니다."
    },
    {
      "type": "formula",
      "title": "대표 표준형",
      "body": "가로 장축 타원과 가로로 열린 쌍곡선의 표준형입니다.",
      "formula": "x²/a²+y²/b²=1, x²/a²-y²/b²=1"
    },
    {
      "type": "concept",
      "title": "초점에서 타원 방정식 유도",
      "body": "초점이 (±c,0)이고 두 초점까지 거리의 합이 2a이면 거리식 √((x-c)²+y²)+√((x+c)²+y²)=2a를 두 번 제곱해 x²/a²+y²/b²=1을 얻으며 b²=a²-c²입니다."
    },
    {
      "type": "concept",
      "title": "초점에서 쌍곡선 방정식 유도",
      "body": "초점이 (±c,0)이고 거리 차의 절댓값이 2a이면 두 거리식의 차를 두 번 제곱해 x²/a²-y²/b²=1을 얻으며 c²=a²+b²입니다."
    },
    {
      "type": "example",
      "title": "타원 읽기",
      "prompt": "x²/25+y²/9=1의 장축 꼭짓점을 구하세요.",
      "steps": [
        "큰 분모 25가 x항 아래에 있어 장축은 가로입니다.",
        "a=5입니다.",
        "중심이 원점이므로 장축 꼭짓점은 (-5,0),(5,0)입니다."
      ],
      "answer": "(-5,0),(5,0)"
    }
  ],
