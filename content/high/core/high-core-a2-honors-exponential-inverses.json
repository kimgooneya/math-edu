  "theory": [
    {"type":"concept","title":"역함수 관계","body":"b>0, b≠1일 때 y=b^x와 y=log_b x는 서로 역함수이며 그래프는 y=x에 대해 대칭입니다."},
    {"type":"formula","title":"역합성","body":"각 함수의 출력을 다른 함수에 넣으면 원래 입력을 되찾습니다.","formula":"log_b(b^x)=x, b^(log_b x)=x (x>0)"},
    {"type":"concept","title":"방정식 풀이","body":"지수식을 로그식으로, 로그식을 지수식으로 바꾸어 미지수를 고립시킵니다. 로그의 진수는 반드시 양수여야 합니다."},
    {"type":"example","title":"역관계 적용","prompt":"log₃(x-1)=2를 푸세요.","steps":["지수형으로 x-1=3²입니다.","x-1=9이므로 x=10입니다.","진수 9가 양수이므로 유효합니다."],"answer":"10"}
  ],
  "problems": [
    {"id":"high-core-a2-honors-exponential-inverses-p01","type":"integer","prompt":"log₂(2^7)의 값을 구하세요.","answer":7,"hints":["역합성을 사용하세요.","log_b(b^x)=x입니다."],"explanation":"값은 7입니다."},
    {"id":"high-core-a2-honors-exponential-inverses-p02","type":"number","prompt":"10^(log₁₀ 6)의 값을 구하세요.","answer":6,"hints":["지수와 로그는 역연산입니다.","10^(log₁₀x)=x입니다."],"explanation":"값은 6입니다."},
    {"id":"high-core-a2-honors-exponential-inverses-p03","type":"integer","prompt":"log₅x=3을 풀어 x를 구하세요.","answer":125,"hints":["지수형으로 바꾸세요.","x=5³입니다."],"explanation":"x=125입니다."},
    {"id":"high-core-a2-honors-exponential-inverses-p04","type":"integer","prompt":"2^x=32를 풀어 x를 구하세요.","answer":5,"hints":["양변에 log₂를 적용하세요.","32=2⁵입니다."],"explanation":"x=5입니다."},
    {"id":"high-core-a2-honors-exponential-inverses-p05","type":"choice","prompt":"y=3^x의 역함수를 고르세요.","answer":"C","hints":["x와 y를 바꾸세요.","밑 3인 로그를 사용하세요."],"explanation":"역함수는 y=log₃x입니다.","choices":[{"id":"A","label":"y=x³"},{"id":"B","label":"y=1/3^x"},{"id":"C","label":"y=log₃x"},{"id":"D","label":"y=3x"}]},
