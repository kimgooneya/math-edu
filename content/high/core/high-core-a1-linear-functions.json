  "theory": [
    {
      "type": "concept",
      "title": "함수의 정의",
      "body": "함수는 정의역의 각 입력에 출력 하나만 대응시키는 규칙입니다. 같은 출력이 여러 입력에서 나오는 것은 가능하지만 한 입력에 서로 다른 두 출력이 대응하면 함수가 아닙니다."
    },
    {
      "type": "concept",
      "title": "기울기와 절편",
      "body": "y=mx+b에서 m은 입력이 1 증가할 때 출력의 변화량이고 b는 입력이 0일 때의 출력입니다. 단위를 함께 쓰면 실제 의미가 분명해집니다."
    },
    {
      "type": "formula",
      "title": "두 점의 기울기",
      "body": "서로 다른 두 점에서 변화율을 계산합니다.",
      "formula": "m=(y₂-y₁)/(x₂-x₁)"
    },
    {
      "type": "example",
      "title": "표에서 함수식 구하기",
      "prompt": "점 (1,5), (3,11)을 지나는 선형 함수식을 구하세요.",
      "steps": [
        "기울기는 (11-5)/(3-1)=3입니다.",
        "y=3x+b에 (1,5)를 대입하면 b=2입니다.",
        "따라서 y=3x+2입니다."
      ],
      "answer": "y=3x+2"
    }
  ],
