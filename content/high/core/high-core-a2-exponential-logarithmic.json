  "theory": [
    {
      "type": "concept",
      "title": "지수 성장과 감쇠",
      "body": "y=ab^x에서 a는 시작값이고 b>1이면 성장, 0<b<1이면 감쇠입니다. 같은 양이 일정한 비율로 변하는 상황은 지수 모델이 적합합니다."
    },
    {
      "type": "concept",
      "title": "로그는 역함수",
      "body": "log_b x는 b를 몇 제곱해야 x가 되는지를 나타냅니다. 지수함수와 로그함수의 그래프는 y=x에 대해 대칭이며 로그의 정의역은 양수입니다."
    },
    {
      "type": "formula",
      "title": "로그 법칙",
      "body": "곱은 로그의 합, 몫은 차, 거듭제곱은 계수로 바뀝니다.",
      "formula": "log_b(MN)=log_bM+log_bN, log_b(M^p)=p log_bM"
    },
    {
      "type": "example",
      "title": "지수방정식",
      "prompt": "2^(x+1)=16을 푸세요.",
      "steps": [
        "16=2⁴로 같은 밑으로 나타냅니다.",
        "지수가 같으므로 x+1=4입니다.",
        "x=3입니다."
      ],
      "answer": "x=3"
    }
  ],
