  ],
  "theory": [
    {
      "type": "concept",
      "title": "사건의 집합 표현",
      "body": "사건 A 또는 B는 합집합, A와 B가 동시에 일어나는 사건은 교집합, A가 일어나지 않는 사건은 여집합입니다. 벤다이어그램은 중복을 시각화합니다."
    },
    {
      "type": "concept",
      "title": "조건부확률과 독립",
      "body": "B가 일어났다는 조건에서 A의 확률은 P(A∩B)/P(B)입니다. P(A|B)=P(A)이면 B의 발생이 A의 확률을 바꾸지 않으므로 독립입니다."
    },
    {
      "type": "formula",
      "title": "덧셈과 곱셈 법칙",
      "body": "합사건에서는 겹친 부분을 한 번 빼고, 연속 사건에서는 조건부확률을 곱합니다.",
      "formula": "P(A∪B)=P(A)+P(B)-P(A∩B), P(A∩B)=P(A|B)P(B)"
    },
    {
      "type": "example",
      "title": "카드 조건부확률",
      "prompt": "표준 카드에서 뽑은 카드가 그림 카드임을 알 때 왕일 확률을 구하세요.",
      "steps": [
        "그림 카드는 J,Q,K가 각 무늬에 있어 12장입니다.",
        "그중 왕은 4장입니다.",
        "조건부확률은 4/12=1/3입니다."
      ],
      "answer": "1/3"
    }
  ],
