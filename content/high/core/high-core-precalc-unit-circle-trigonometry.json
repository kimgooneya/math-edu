  "theory": [
    {
      "type": "concept",
      "title": "라디안",
      "body": "반지름 r인 원에서 길이 r인 호가 만드는 중심각이 1라디안입니다. 한 바퀴는 2π라디안이며 라디안은 호의 길이와 각을 직접 연결합니다."
    },
    {
      "type": "concept",
      "title": "단위원",
      "body": "단위원에서 각 θ의 종점 좌표는 (cosθ,sinθ)입니다. tanθ=sinθ/cosθ이며 cosθ=0인 곳에서는 정의되지 않습니다."
    },
    {
      "type": "formula",
      "title": "기본 항등식",
      "body": "단위원 방정식 x²+y²=1에서 피타고라스 항등식이 나옵니다.",
      "formula": "sin²θ+cos²θ=1, tanθ=sinθ/cosθ"
    },
    {
      "type": "example",
      "title": "라디안과 호의 길이",
      "prompt": "반지름 3인 원에서 중심각이 2라디안일 때 호의 길이를 구하세요.",
      "steps": [
        "라디안 정의에서 호의 길이는 s=rθ입니다.",
        "r=3, θ=2를 대입합니다.",
        "s=3·2=6입니다."
      ],
      "answer": "6"
    }
  ],
