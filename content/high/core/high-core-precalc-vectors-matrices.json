  "theory": [
    {
      "type": "concept",
      "title": "벡터와 성분",
      "body": "벡터는 크기와 방향을 가진 양입니다. 시작점 P에서 끝점 Q로 가는 벡터의 성분은 Q-P이며, 벡터 덧셈은 성분별로 계산합니다."
    },
    {
      "type": "concept",
      "title": "행렬과 변환",
      "body": "행렬은 자료나 선형변환을 직사각형 배열로 나타냅니다. 행렬 곱 AB는 A의 열 수와 B의 행 수가 같을 때 정의되며 일반적으로 AB와 BA는 다릅니다."
    },
    {
      "type": "formula",
      "title": "크기와 내적",
      "body": "내적이 0인 영벡터가 아닌 두 벡터는 수직입니다.",
      "formula": "|⟨a,b⟩|=√(a²+b²), ⟨a,b⟩·⟨c,d⟩=ac+bd"
    },
    {
      "type": "example",
      "title": "벡터 성분",
      "prompt": "P(-1,2)에서 Q(4,-2)로 향하는 벡터와 크기를 구하세요.",
      "steps": [
        "Q-P=(4-(-1),-2-2)=(5,-4)입니다.",
        "크기는 √(5²+(-4)²)입니다.",
        "따라서 벡터는 ⟨5,-4⟩, 크기는 √41입니다."
      ],
      "answer": "⟨5,-4⟩, √41"
    },
    {
      "type": "concept",
      "title": "벡터 연산과 물리량",
      "body": "위치, 변위, 속도, 힘처럼 크기와 방향을 함께 가진 양은 벡터로 모델링합니다. u+v는 v를 u의 끝에 이어 붙인 합성 이동이고, u-v=u+(-v)이며, cu는 |c|배로 늘리거나 줄이고 c<0이면 방향을 뒤집습니다. 같은 크기와 같은 방향의 벡터는 놓인 위치가 달라도 같습니다."
    },
    {
      "type": "example",
      "title": "속도 벡터 합성",
      "prompt": "동쪽으로 30 km/h로 움직이는 배가 북쪽으로 40 km/h인 해류를 만날 때 지면에 대한 속력과 방향을 구하세요.",
      "steps": [
        "동쪽을 x축, 북쪽을 y축으로 두면 속도 벡터는 ⟨30,40⟩입니다.",
        "속력은 √(30²+40²)=50 km/h입니다.",
        "방향각은 tan⁻¹(40/30)≈53.1°이므로 동쪽에서 북쪽으로 약 53.1°입니다."
      ],
      "answer": "50 km/h, 동쪽에서 북쪽으로 약 53.1°"
    },
    {
      "type": "concept",
      "title": "자료 행렬과 행렬 연산",
      "body": "행렬의 행과 열에 범주를 정해 판매량이나 이동 자료를 저장할 수 있습니다. 같은 크기의 행렬은 대응 원소끼리 더하고 빼며, 스칼라곱은 모든 원소에 같은 수를 곱합니다. 행렬 곱은 선형변환의 합성을 나타내고 일반적으로 AB≠BA입니다."
    },
    {
      "type": "formula",
      "title": "항등행렬·행렬식·역행렬",
      "body": "2×2 항등행렬 I는 AI=IA=A를 만족합니다. det A≠0일 때만 역행렬이 존재하며, 선형변환은 넓이를 |det A|배로 바꿉니다.",
      "formula": "A=[[a,b],[c,d]], det A=ad-bc, A⁻¹=(1/(ad-bc))[[d,-b],[-c,a]]"
    }
  ],
