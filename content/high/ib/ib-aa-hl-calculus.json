    {"id": "ib-aa-hl-calculus-p01", "type": "number", "prompt": "곡선 x²+y²=25에서 점 (3,4)의 d²y/dx²을 구하세요.", "answer": -0.390625, "tolerance": 0.000001, "hints": ["먼저 y'=-x/y를 구한 뒤 다시 미분하세요.", "y''=-(x²+y²)/y³로 정리할 수 있습니다."], "explanation": "점에서 y''=-25/4³=-25/64=-0.390625입니다."},
    {"id": "ib-aa-hl-calculus-p02", "type": "number", "prompt": "x가 0으로 갈 때 (e^x-1-x)/x²의 극한을 구하세요.", "answer": 0.5, "hints": ["처음과 한 번 미분한 뒤에도 0/0 꼴입니다.", "두 번 로피탈 법칙을 적용하면 e^x/2입니다."], "explanation": "극한은 e^0/2=1/2입니다. Maclaurin 전개의 x²/2 항으로도 확인됩니다."},
    {"id": "ib-aa-hl-calculus-p03", "type": "choice", "prompt": "∫x e^x dx의 부정적분을 고르세요.", "choices": [{"id": "a", "label": "e^x(x-1)+C"}, {"id": "b", "label": "xe^x+C"}, {"id": "c", "label": "e^x(x+1)+C"}, {"id": "d", "label": "x²e^x/2+C"}], "answer": "a", "hints": ["부분적분에서 u=x, dv=e^x dx로 두세요.", "uv-∫vdu를 적용하세요."], "explanation": "∫xe^x dx=xe^x-∫e^x dx=e^x(x-1)+C입니다."},
    {"id": "ib-aa-hl-calculus-p04", "type": "number", "prompt": "미분방정식 dy/dx=2xy, y(0)=3의 해에서 y(1)의 값을 구하세요.", "answer": 8.154845485377136, "tolerance": 0.000001, "hints": ["dy/y=2x dx로 분리하세요.", "ln y=x²+C이고 초기조건에서 C=ln3입니다."], "explanation": "해는 y=3e^(x²)이므로 y(1)=3e≈8.154845입니다."},
    {"id": "ib-aa-hl-calculus-p05", "type": "number", "prompt": "e^x의 Maclaurin 전개를 x³항까지 사용하여 e^0.2를 근사하세요.", "answer": 1.2213333333333334, "tolerance": 0.000001, "hints": ["근사는 1+x+x²/2+x³/6입니다.", "x=0.2를 대입하고 네 항을 더하세요."], "explanation": "1+0.2+0.04/2+0.008/6=1.221333...입니다."},
