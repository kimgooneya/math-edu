  "theory": [
    {"type": "concept", "title": "비와 비의 언어", "body": "비 a:b는 한 양 a를 다른 양 b와 곱셈적으로 비교합니다. 순서가 중요하며, 8:12와 2:3처럼 두 항에 같은 수를 곱하거나 나눈 비는 서로 동치입니다."},
    {"type": "concept", "title": "단위비율", "body": "a:b에서 b가 0이 아닐 때 a/b는 한 단위당 양을 나타냅니다. 3시간에 24 km를 이동하면 단위비율은 시간당 8 km입니다."},
    {"type": "concept", "title": "비례 표현", "body": "동치비는 표, 이중 수직선, 좌표, 식으로 나타낼 수 있습니다. y=kx에서 k는 단위비율이며 그래프는 원점을 지납니다."},
    {"type": "concept", "title": "퍼센트와 단위 변환", "body": "p%는 p/100의 비율입니다. 단위 변환에서는 값에 변환비를 곱하고, 분자와 분모의 단위가 약분되는지 확인합니다."}
  ],
  "problems": [
    {"id": "middle-grade-6-rp-p01", "type": "choice", "prompt": "비 8:12와 동치인 비를 고르세요.", "choices": [{"id": "a", "label": "2:3"}, {"id": "b", "label": "3:2"}, {"id": "c", "label": "4:5"}, {"id": "d", "label": "6:8"}], "answer": "a", "hints": ["두 항을 같은 수로 나누세요.", "8과 12를 모두 4로 나눠 보세요."], "explanation": "8÷4=2이고 12÷4=3이므로 8:12=2:3입니다."},
    {"id": "middle-grade-6-rp-p02", "type": "integer", "prompt": "3시간에 24 km를 이동했습니다. 한 시간당 이동 거리는 몇 km인가요?", "answer": 8, "hints": ["전체 거리를 시간으로 나누세요.", "24÷3을 계산하세요."], "explanation": "24÷3=8이므로 단위비율은 시간당 8 km입니다."},
    {"id": "middle-grade-6-rp-p03", "type": "integer", "prompt": "연필 5자루가 15달러일 때 같은 비율로 연필 8자루의 가격은 몇 달러인가요?", "answer": 24, "hints": ["먼저 연필 한 자루의 가격을 구하세요.", "15÷5=3이고 3×8을 계산하세요."], "explanation": "한 자루는 3달러이므로 8자루는 3×8=24달러입니다."},
    {"id": "middle-grade-6-rp-p04", "type": "integer", "prompt": "80의 35%는 얼마인가요?", "answer": 28, "hints": ["35%를 35/100으로 나타내세요.", "80×0.35를 계산하세요."], "explanation": "80×35/100=28이므로 80의 35%는 28입니다."},
