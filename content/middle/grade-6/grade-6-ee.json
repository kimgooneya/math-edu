  "theory": [
    {"type": "concept", "title": "지수와 변수식", "body": "3^4는 3을 네 번 곱한 수입니다. 변수는 정해지지 않았거나 변할 수 있는 수를 나타내며, 2x+5에서 2는 계수이고 5는 상수항입니다."},
    {"type": "concept", "title": "동치인 식", "body": "교환·결합·분배법칙을 사용하면 값이 항상 같은 식을 만들 수 있습니다. 예를 들어 4(a+3)=4a+12입니다."},
    {"type": "concept", "title": "방정식과 부등식", "body": "방정식의 해는 등식을 참으로 만드는 값입니다. 부등식 x>5는 5보다 큰 모든 수를 해로 가지며 수직선에서는 5에 열린 점을 찍고 오른쪽을 칠합니다."},
    {"type": "concept", "title": "두 변수의 관계", "body": "독립변수의 값에 따라 종속변수가 결정됩니다. 관계를 표, 그래프, 식으로 나타내고 각 표현에서 대응하는 값을 읽을 수 있습니다."}
  ],
  "problems": [
    {"id": "middle-grade-6-ee-p01", "type": "integer", "prompt": "3^4의 값을 구하세요.", "answer": 81, "hints": ["3을 네 번 곱하세요.", "3×3×3×3을 계산하세요."], "explanation": "3^4=3×3×3×3=81입니다."},
    {"id": "middle-grade-6-ee-p02", "type": "integer", "prompt": "x=6일 때 2x+5의 값을 구하세요.", "answer": 17, "hints": ["x 자리에 6을 넣으세요.", "2×6+5를 계산하세요."], "explanation": "2(6)+5=12+5=17입니다."},
    {"id": "middle-grade-6-ee-p03", "type": "choice", "prompt": "4(a+3)과 동치인 식을 고르세요.", "choices": [{"id": "a", "label": "4a+3"}, {"id": "b", "label": "4a+7"}, {"id": "c", "label": "4a+12"}, {"id": "d", "label": "a+12"}], "answer": "c", "hints": ["분배법칙을 사용하세요.", "4를 괄호 안의 두 항에 각각 곱하세요."], "explanation": "4(a+3)=4a+12입니다."},
    {"id": "middle-grade-6-ee-p04", "type": "integer", "prompt": "방정식 5x=35의 해를 구하세요.", "answer": 7, "hints": ["양변을 5로 나누세요.", "35÷5를 계산하세요."], "explanation": "5x=35의 양변을 5로 나누면 x=7입니다."},
    {"id": "middle-grade-6-ee-p05", "type": "choice", "prompt": "부등식 x+7>12의 해를 고르세요.", "choices": [{"id": "a", "label": "x>5"}, {"id": "b", "label": "x<5"}, {"id": "c", "label": "x>19"}, {"id": "d", "label": "x<19"}], "answer": "a", "hints": ["양변에서 7을 빼세요.", "12-7=5이고 부등호 방향은 바뀌지 않습니다."], "explanation": "x+7>12의 양변에서 7을 빼면 x>5입니다."},
    {"id": "middle-grade-6-ee-p06", "type": "integer", "prompt": "y=3x+2에서 x=4일 때 y의 값을 구하세요.", "answer": 14, "hints": ["식의 x에 4를 대입하세요.", "3×4+2를 계산하세요."], "explanation": "y=3(4)+2=14입니다."}
  ]
